# .gitignore — ab-cloud-research
# NOTE: PDF/DOCX/PPTX files are FIRST-CLASS CONTENT of this repository
# (monographs, preprints, 3D lab outputs) — they are NOT ignored here.
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# ── Build outputs (regenerated by tooling, never committed) ──
dist/            # web portal bundle — produced by `npm run build` (scripts/build-site.mjs)
dist-docs/       # MkDocs Material site — produced by `make docs` / `mkdocs build`
node_modules/
__pycache__/
*.pyc
.ruff_cache/
.mkdocs-cache/


