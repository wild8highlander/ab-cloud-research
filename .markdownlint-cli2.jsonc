{
  "config": {
    "MD002": false,
    "MD004": false,
    "MD007": {
      "indent": 2
    },
    "MD010": false,
    "MD012": {
      "maximum": 3
    },
    "MD013": false,
    "MD022": false,
    "MD024": false,
    "MD025": false,
    "MD026": false,
    "MD028": false,
    "MD029": {
      "style": "one_or_ordered"
    },
    "MD031": false,
    "MD032": false,
    "MD033": {
      "allowed_elements": [
        "div",
        "p",
        "span",
        "img",
        "br",
        "hr",
        "sub",
        "sup",
        "kbd",
        "details",
        "summary",
        "table",
        "thead",
        "tbody",
        "tr",
        "th",
        "td",
        "a",
        "picture",
        "source",
        "figcaption",
        "figure",
        "code",
        "pre",
        "h1",
        "h2",
        "h3",
        "h4",
        "center",
        "font",
        "strong",
        "em"
      ]
    },
    "MD034": false,
    "MD035": {
      "style": "---"
    },
    "MD036": false,
    "MD037": false,
    "MD040": false,
    "MD041": false,
    "MD045": false,
    "MD046": false,
    "MD049": {
      "style": "asterisk"
    },
    "MD050": {
      "style": "asterisk"
    },
    "MD060": false,
    "MD051": false
  },
  "globs": [
    "*.md",
    "docs/**/*.md",
    "formal/**/*.md",
    "code/**/*.md",
    "verification/**/*.md",
    "Hilbert_Polya/*.md",
    "Hilbert_Polya/docs/*.md",
    "apps/*.md",
    ".github/*.md",
    "AB_Cloud_Academic_Package/AB_Cloud_Academic_Package/*.md",
    "AB_Cloud_Academic_Package/AB_Cloud_Academic_Package/00_meta/**/*.md",
    "AB_Cloud_Academic_Package/AB_Cloud_Academic_Package/02_data/*.md",
    "AB_Cloud_Academic_Package/AB_Cloud_Academic_Package/03_figures/*.md",
    "AB_Cloud_Academic_Package/AB_Cloud_Academic_Package/04_reports/*.md",
    "AB_Cloud_Academic_Package/AB_Cloud_Academic_Package/05_logs/*.md",
    "AB_Cloud_Academic_Package/AB_Cloud_Academic_Package/06_code/**/*.md",
    "AB_Cloud_Academic_Package/AB_Cloud_Academic_Package/07_web_lab/*.md",
    "AB_Cloud_Academic_Package/AB_Cloud_Academic_Package/09_tests/**/*.md",
    "AB_Cloud_Academic_Package/README.md",
    "AB_Cloud_Academic_Package/Journal/*.md",
    "meridian-spectral-observatory/docs/*.md",
    "Hilbert_Polya/computations/*/README.md",
    "Hilbert_Polya/computations/*/README.en.md"
  ],
  "ignores": [
    "**/node_modules/**",
    "**/dist/**",
    "**/site/**",
    "AB_Cloud_Academic_Package/**",
    "**/unpacked/**",
    "**/run_data/**",
    "verification/spinor64/output/**",
    "results/**",
    "**/outputs/**"
  ]
}
