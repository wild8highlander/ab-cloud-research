# AB-Cloud unified package - environment template
# Copy to .env and adjust. The package works fully offline without any of these.

# Language and theme for CLI runs
AB_CLOUD_LANG=en
AB_CLOUD_THEME=dark

# Reproduction root
AB_CLOUD_OUT=./out

# Optional: FastAPI host/port for `run api`
AB_CLOUD_API_HOST=127.0.0.1
AB_CLOUD_API_PORT=8321

# Optional: webhook for `--notify=webhook` (leave empty to disable)
AB_CLOUD_NOTIFY_WEBHOOK=
